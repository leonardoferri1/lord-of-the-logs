{
  "name": "lord-of-the-logs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter @logs/server --filter @logs/web dev",
    "build": "pnpm --filter @logs/shared build && pnpm --filter @logs/server build && pnpm --filter @logs/web build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @logs/server exec prisma generate",
    "db:migrate": "pnpm --filter @logs/server exec prisma migrate deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "typescript-eslint": "^8.26.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.2",
    "vitest": "^3.0.8",
    "@types/node": "^22.13.10",
    "socket.io-client": "^4.8.1"
  }
}
